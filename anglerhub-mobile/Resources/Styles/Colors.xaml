<?xml version="1.0" encoding="UTF-8" ?>
<!--
    Bewust dezelfde kleurwaarden als de webapp (resources/css/app.css,
    zie de anglerhub-web-repo), zodat de app er meteen herkenbaar
    hetzelfde uitziet als het web-dashboard:
      #081018 = de donkere navy achtergrond
      #0f172a = de iets lichtere kaart/dropdown-achtergrond
      #22c55e = de hoofdaccentkleur (knoppen, focus-rand, actieve status)
      #4ade80 = de hover-variant daarvan
    De "glas"-kaarten in de webapp (transparante achtergrond + zachte
    rand) worden hieronder vertaald naar CardBackground/CardBorder met
    dezelfde ondoorzichtigheid.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="AppBackground">#081018</Color>
    <Color x:Key="SurfaceDark">#0f172a</Color>

    <Color x:Key="CardBackground">#0D1B2A</Color>
    <Color x:Key="CardBorder">#26FFFFFF</Color>

    <Color x:Key="Primary">#22c55e</Color>
    <Color x:Key="PrimaryHover">#4ade80</Color>
    <Color x:Key="PrimaryDark">#16a34a</Color>

    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#E5E7EB</Color>
    <Color x:Key="TextMuted">#9CA3AF</Color>
    <Color x:Key="TextFaint">#6B7280</Color>

    <Color x:Key="Danger">#ef4444</Color>
    <Color x:Key="DangerLight">#f87171</Color>
    <Color x:Key="Warning">#f59e0b</Color>
    <Color x:Key="WarningLight">#fbbf24</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="Transparent">Transparent</Color>

</ResourceDictionary>
